<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/UnityThemes/stylesheet.uss?fileID=7433441132597879392&amp;guid=1907f1cdcf0bd6047803b1133bafecc3&amp;type=3#stylesheet"/>
    <ui:VisualElement name="OuterContainer" class="container" style="flex-grow: 1; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(77, 156, 224); border-right-color: rgb(77, 156, 224); border-top-color: rgb(77, 156, 224); border-bottom-color: rgb(77, 156, 224);">
        <ui:Label text="Statistics" name="Title" style="font-size: 40px; -unity-font-style: bold; height: 61px; width: 467px; position: absolute; top: -9px; left: 3px;"/>
        <ui:VisualElement name="InnerContainer" class="container" style="flex-grow: 1; flex-basis: auto; width: auto; height: initial; aspect-ratio: auto; visibility: visible; padding-top: 0; margin-top: 60px; margin-left: 10px; margin-right: 10px; margin-bottom: 90px; background-color: rgba(101, 101, 101, 0.28);">
            <ui:Label text="Velocity (m/s): " name="VelocityLabel" style="font-size: 20px; -unity-font-style: bold; height: 32px; width: 431px; margin-left: 4px; margin-bottom: 4px; padding-left: 2px;"/>
            <ui:Label text="0.0" name="VelocityValue" style="font-size: 20px; -unity-font-style: bold; height: 28px; width: 431px; margin-left: 4px; margin-bottom: 4px; padding-left: 2px;"/>
            <ui:Label text="Point of Contact:" name="ContactAreaLabel" style="font-size: 20px; -unity-font-style: bold; height: 26px; width: 431px; margin-left: 4px; margin-bottom: 6px; padding-left: 2px;"/>
            <ui:Label text="N/A" name="ContactAreaValue" style="font-size: 20px; -unity-font-style: bold; height: 32px; width: 431px; margin-left: 4px; margin-bottom: 4px; padding-left: 2px;"/>
        </ui:VisualElement>
        <ui:Label text="Hit Counter: " name="HitCounterLabel" style="position: absolute; top: 248px; left: 7px; height: 71px; width: 292px; -unity-text-align: middle-left; font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255); border-left-color: rgb(255, 221, 87); border-right-color: rgb(255, 221, 87); border-top-color: rgb(255, 221, 87); border-bottom-color: rgb(255, 221, 87); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; padding-left: 10px; background-color: rgba(101, 101, 101, 0.28);"/>
        <ui:Image source="project://database/Assets/glove.png?fileID=2800000&amp;guid=f0a8691315f1b0842b514e1bec7464a7&amp;type=3#glove" style="position: absolute; height: 76px; width: 142px; top: 249px; left: 316px;"/>
    </ui:VisualElement>
</ui:UXML>
